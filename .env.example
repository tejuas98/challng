# Copy this file to `.env` (`.env` is git-ignored and will NEVER be pushed to GitHub).
# Add only the free-tier or local keys you want to use:

# 1. Local Offline AI (100% Free, No Key Needed — already detected if Ollama is running)
OLLAMA_HOST=http://127.0.0.1:11434

# 2. Google Gemini Free Tier (Google AI Studio: aistudio.google.com)
GEMINI_API_KEY=

# 3. Groq Free Tier Llama Vision (console.groq.com)
GROQ_API_KEY=

# 4. OpenRouter Free Vision Models (openrouter.ai)
OPENROUTER_API_KEY=

# 5. Mistral Pixtral Free Tier (console.mistral.ai)
MISTRAL_API_KEY=

# 6. Hugging Face Free Inference Router (huggingface.co/settings/tokens)
HF_TOKEN=

# Optional Paid Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
